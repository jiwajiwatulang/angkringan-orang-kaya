{
  // Config deploy Cloudflare: SakuNota Edge Production
  "name": "angkringan-orang-kaya",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "SAKUNOTA_MULTI_DEVICE": "enabled"
  },
  "ratelimits": [
    { "name": "PUBLIC_RATE_LIMITER", "namespace_id": "2026101901", "simple": { "limit": 30, "period": 60 } },
    { "name": "MULTI_DEVICE_RATE_LIMITER", "namespace_id": "2026102304", "simple": { "limit": 120, "period": 60 } }
  ],
  "routes": [
    { "pattern": "sakunota.my.id", "custom_domain": true },
    { "pattern": "www.sakunota.my.id", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakunota-production-db",
      "database_id": "09a2c118-5c9d-49e8-a199-d14e930d02f2",
      "migrations_dir": "migrations"
    }
  ]
}
